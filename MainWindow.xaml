<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Aether_Windows.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Aether_Windows"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:wct="using:CommunityToolkit.WinUI.Controls"
    mc:Ignorable="d"
    Title="Aether">

    <Window.SystemBackdrop>
        <MicaBackdrop Kind="Base"/>
    </Window.SystemBackdrop>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280"/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        
        <!--TODO: Replace sidebar with templated controls-->
        <!--Left Sidebar-->
        <NavigationView x:Name="navSidebar" PaneDisplayMode="Left" IsPaneToggleButtonVisible="False">
            <NavigationView.PaneHeader>
                <Grid Height="52" Margin="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Button VerticalAlignment="Stretch" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Style="{ThemeResource AccentButtonStyle}" CornerRadius="24,4,4,24" Margin="0,0,2,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0" Spacing="12">
                            <FontIcon Glyph="&#xECC8;"/>
                            <TextBlock Style="{ThemeResource BodyStrongTextBlockStyle}" Text="Create a Vault"/>
                        </StackPanel>
                    </Button>
                    <Button Grid.Column="1" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Style="{ThemeResource AccentButtonStyle}" CornerRadius="4,24,24,4">
                        <Button.Flyout>
                            <Flyout Placement="Bottom" AreOpenCloseAnimationsEnabled="True" ShouldConstrainToRootBounds="False">
                                <StackPanel Margin="-16" CornerRadius="16">
                                    <Button Width="350" HorizontalContentAlignment="Left" CornerRadius="0" Background="Transparent" Padding="12,16">
                                        <StackPanel Orientation="Horizontal" Spacing="12">
                                            <FontIcon Glyph="&#xE945;" FontSize="22" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                                            <StackPanel Width="300">
                                                <TextBlock Style="{ThemeResource BodyStrongTextBlockStyle}" Text="Quick create"/>
                                                <TextBlock Style="{ThemeResource CaptionTextBlockStyle}" TextWrapping="Wrap">
                                                    <Run>Create a vault with default configs. This is the default action when you click </Run>
                                                    <Run FontWeight="Bold" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}">Create a vault.</Run>
                                                </TextBlock>
                                            </StackPanel>
                                        </StackPanel>
                                    </Button>
                                    <Button Width="350" HorizontalContentAlignment="Left" CornerRadius="0" Background="Transparent" Padding="12,16">
                                        <StackPanel Orientation="Horizontal" Spacing="12">
                                            <FontIcon Glyph="&#xE9F5;" FontSize="22" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                                            <StackPanel Width="300">
                                                <TextBlock Style="{ThemeResource BodyStrongTextBlockStyle}" Text="Custom vault"/>
                                                <TextBlock Style="{ThemeResource CaptionTextBlockStyle}" TextWrapping="Wrap">
                                                    <Run>Modify vault name and permission before sharing. Vault name can't be modified after creation.</Run>
                                                </TextBlock>
                                            </StackPanel>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Flyout>
                        </Button.Flyout>
                        <FontIcon Glyph="&#xE96E;" FontSize="14"/>
                    </Button>

                </Grid>
            </NavigationView.PaneHeader>
            <NavigationView.MenuItems>
            <NavigationViewItemSeparator Margin="0,12"/>
            <NavigationViewItem Height="52" CornerRadius="12" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Margin="12,0">
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <FontIcon Glyph="&#xE80F;"/>
                    <TextBlock Style="{ThemeResource BodyStrongTextBlockStyle}" Text="Home"/>
                </StackPanel>
            </NavigationViewItem>
                
            <NavigationViewItem Height="52" CornerRadius="12" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Margin="12,0">
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <FontIcon Glyph="&#xF540;"/>
                    <TextBlock Style="{ThemeResource BodyStrongTextBlockStyle}" Text="My Vault"/>
                </StackPanel>
            </NavigationViewItem>

            <NavigationViewItem Height="52" CornerRadius="12" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Margin="12,0">
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <FontIcon Glyph="&#xE716;"/>
                    <TextBlock Style="{ThemeResource BodyStrongTextBlockStyle}" Text="Shared"/>
                </StackPanel>
            </NavigationViewItem>
            </NavigationView.MenuItems>
        </NavigationView>
        <StackPanel VerticalAlignment="Center">
            

            <Border BorderThickness="1" Margin="0,8" BorderBrush="{ThemeResource ControlElevationBorderBrush}"/>

            
            

        </StackPanel>

        <Frame x:Name="viewportFrame" Loaded="viewportFrame_Loaded" Navigated="viewportFrame_Navigated"
               Grid.Column="1" Margin="0"  Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"/>

    </Grid>
</Window>
